# MrMarket 环境变量配置
# 复制此文件为 .env 后修改实际值

# 数据库 (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://mrmarket:mrmarket@localhost:5432/mrmarket

# 缓存 (Redis)
REDIS_URL=redis://localhost:6379/0

# 调试模式
DEBUG=true

# 数据源 — Tushare Pro Token（可选，去 https://tushare.pro 注册获取）
TUSHARE_TOKEN=

# AI 服务 — DeepSeek（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# AI 服务 — OpenAI（可选）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
