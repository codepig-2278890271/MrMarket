# ================================================================
# MrMarket .gitignore
# ================================================================

# 环境变量（包含敏感信息）
.env
backend/.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.egg
.pytest_cache/

# Node
node_modules/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# 数据文件（本地缓存）
data/*.parquet
data/*.h5

# 日志
*.log
logs/
.logs/
